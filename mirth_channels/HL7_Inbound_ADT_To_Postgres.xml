  <postprocessingScript>// This script executes once after a message has been processed
// Responses returned from here will be stored as &quot;Postprocessor&quot; in the response map&#xd;&#xd;// Postprocessor runs after every message attempt (SUCCESS, FILTERED, or ERROR)
try {
    // Only execute DLQ persistence if the message encountered a processing or transformation error
    if (typeof responseStatus !== &apos;undefined&apos; &amp;&amp; responseStatus.toString() === &apos;ERROR&apos; || 
        typeof messageStatus !== &apos;undefined&apos; &amp;&amp; messageStatus.toString() === &apos;ERROR&apos;) {

        logger.warn(&quot;DLQ Postprocessor: Intercepted failed message. Writing to dead_letter_queue...&quot;);

        // 1. Resolve database connection settings dynamically
        var dbHost = java.lang.System.getenv(&quot;DB_HOST&quot;) || configurationMap.get(&quot;db_host&quot;) || &quot;health_db&quot;;
        var dbPort = java.lang.System.getenv(&quot;DB_PORT&quot;) || configurationMap.get(&quot;db_port&quot;) || &quot;5432&quot;;
        var dbName = java.lang.System.getenv(&quot;POSTGRES_DB&quot;) || configurationMap.get(&quot;db_name&quot;) || &quot;hospital_ehr&quot;;
        var dbUser = java.lang.System.getenv(&quot;POSTGRES_USER&quot;) || configurationMap.get(&quot;db_user&quot;) || &quot;ehr_admin&quot;;
        var dbPass = java.lang.System.getenv(&quot;POSTGRES_PASSWORD&quot;) || configurationMap.get(&quot;db_password&quot;) || &quot;ehr_password_123&quot;;

        var jdbcUrl = &quot;jdbc:postgresql://&quot; + dbHost + &quot;:&quot; + dbPort + &quot;/&quot; + dbName;
        var dbConn = DatabaseConnectionFactory.createDatabaseConnection(&quot;org.postgresql.Driver&quot;, jdbcUrl, dbUser, dbPass);

        // 2. Extract metadata and escape single quotes for SQL safety
        var chId = channelId ? channelId.toString() : &quot;UNKNOWN&quot;;
        var chName = channelName ? channelName.toString() : &quot;HL7_Inbound_ADT_To_Postgres&quot;;
        var msgId = connectorMessage ? connectorMessage.getMessageId() : -1;

        // Extract raw HL7 payload safely
        var rawPayload = &quot;&quot;;
        try {
            rawPayload = connectorMessage.getRawData().toString();
        } catch (rawErr) {
            rawPayload = &quot;Unable to retrieve raw message body.&quot;;
        }

        // Extract error detail safely
        var errorDetail = &quot;&quot;;
        try {
            errorDetail = connectorMessage.getProcessingError().toString();
        } catch (errErr) {
            errorDetail = &quot;Processing or transformation error occurred.&quot;;
        }

        // Sanitize strings for raw SQL insertion
        rawPayload = rawPayload.replace(/&apos;/g, &quot;&apos;&apos;&quot;);
        errorDetail = errorDetail.replace(/&apos;/g, &quot;&apos;&apos;&quot;);

        // 3. Insert into dead_letter_queue
        var dlqQuery = 
            &quot;INSERT INTO dead_letter_queue (original_channel_id, original_channel_name, message_id, raw_hl7_message, error_message, failed_at, status) &quot; +
            &quot;VALUES (&apos;&quot; + chId + &quot;&apos;, &apos;&quot; + chName + &quot;&apos;, &quot; + msgId + &quot;, &apos;&quot; + rawPayload + &quot;&apos;, &apos;&quot; + errorDetail + &quot;&apos;, CURRENT_TIMESTAMP, &apos;UNRESOLVED&apos;);&quot;;

        dbConn.executeUpdate(dlqQuery);
        dbConn.close();

        logger.info(&quot;DLQ Postprocessor: Successfully recorded failed message ID &quot; + msgId + &quot; to dead_letter_queue.&quot;);
    }
} catch (dlqError) {
    logger.error(&quot;DLQ Postprocessor Critical Failure: &quot; + dlqError.message);
}&#xd;&#xd;
