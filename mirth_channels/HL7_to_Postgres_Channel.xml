            <query>INSERT INTO patients (patient_id, first_name, last_name, dob, gender, assigned_patient_location, updated_at)
VALUES (${patient_id}, ${first_name}, ${last_name}, ${dob}::DATE, ${gender}, ${location}, CURRENT_TIMESTAMP)
ON CONFLICT (patient_id) DO UPDATE 
SET assigned_patient_location = EXCLUDED.assigned_patient_location,
    updated_at = CURRENT_TIMESTAMP;</query>
            <useScript>false</useScript>
